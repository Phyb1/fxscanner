# Copy to .env (gitignored) in the folder where you run fxscan.
# Real environment variables override anything here.
# Quote values that contain special characters (& ^ % # $ spaces).

# Only needed when the broker profile does NOT use attach = true:
FUSION_MT5_LOGIN=12345678
FUSION_MT5_PASSWORD="your-master-password"

# Only needed once the hub is deployed (same value as FX_HMAC_SECRET on the hub):
FX_HUB_SECRET="long-random-string"
